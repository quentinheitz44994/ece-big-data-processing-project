# Copy this file to .env (git-ignored) and adjust the values.

# Contact e-mail sent in the User-Agent header of every Wikimedia request
# (Wikipedia, Wikidata, EventStreams), as required by the Wikimedia User-Agent
# policy: https://foundation.wikimedia.org/wiki/Policy:User-Agent_policy
WIKIMEDIA_CONTACT_EMAIL=your.name@example.org

# Memory of the Spark driver (local mode: driver and executor share one JVM).
# 6g assumes about 10 GB allocated to Docker (see PROJECT.md).
SPARK_DRIVER_MEMORY=6g

# Host ports
JUPYTER_PORT=8888
SPARK_UI_PORT=4040
KAFKA_EXTERNAL_PORT=9092
